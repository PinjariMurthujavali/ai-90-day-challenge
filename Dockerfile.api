# ============================================
# DAY 48: Docker Containerization
# Dockerfile for the Flask API (api.py)
# ============================================
#
# Build:
#   docker build -f Dockerfile.api -t chatbot-api:latest .
#
# Run:
#   docker run -p 8000:8000 \
#     -e GROQ_API_KEY=your_key \
#     -e TURSO_DATABASE_URL=your_turso_url \
#     -e TURSO_AUTH_TOKEN=your_turso_token \
#     -e PORT=8000 \
#     chatbot-api:latest
#
# Multi-stage build: the "builder" stage installs dependencies into an
# isolated location; the final stage copies only that + the app code,
# so the shipped image doesn't carry pip's build cache, compilers, or
# anything else needed only to INSTALL packages, not run them.

# ---------------- Stage 1: builder ----------------
FROM python:3.11-slim AS builder

WORKDIR /build

# Install build-time OS deps only where needed (fpdf2/libsql wheels are
# generally prebuilt for slim images, but gcc is kept as a safety net for
# any package that needs to compile from source on an unusual platform)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt .
RUN pip install --no-cache-dir --user -r requirements-api.txt


# ---------------- Stage 2: runtime ----------------
FROM python:3.11-slim

# Run as a non-root user — never run a production container as root
RUN useradd --create-home --shell /bin/bash appuser

WORKDIR /app

# Bring in only the installed packages from the builder stage, not the
# compiler toolchain or pip's cache
COPY --from=builder /root/.local /home/appuser/.local

# App code: only what the API actually needs at runtime.
# chatbot.db is intentionally NOT baked into the image — it should be
# mounted as a volume or backed by Turso, so container restarts don't
# silently wipe user data (this bit us on Render before Turso was wired up).
COPY api.py .
COPY auth.py .
COPY database.py .
COPY admin_service.py .
COPY requirements-api.txt .

# Make the user-installed packages from the builder stage importable
ENV PATH=/home/appuser/.local/bin:$PATH
ENV PYTHONUNBUFFERED=1

RUN chown -R appuser:appuser /app
USER appuser

EXPOSE 8000
ENV PORT=8000

# Docker-level healthcheck — matches the /api/v1/health endpoint already
# built into api.py, so `docker ps` and orchestrators can see liveness
# without any extra code.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,os,sys; \
    sys.exit(0) if urllib.request.urlopen(f'http://localhost:{os.environ.get(\"PORT\",8000)}/api/v1/health').status == 200 else sys.exit(1)"

CMD ["gunicorn", "-b", "0.0.0.0:8000", "--workers", "2", "--timeout", "60", "api:app"]
